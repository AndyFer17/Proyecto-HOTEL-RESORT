# Ejecutar pnpm setup:dev para generar .env con valores locales aleatorios.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
POSTGRES_PASSWORD=GENERAR_CON_SETUP_DEV
DATABASE_URL=postgresql://clientes:GENERAR_CON_SETUP_DEV@127.0.0.1:5433/clientes
JWT_PRIVATE_KEY_BASE64=GENERAR_CON_SETUP_DEV
JWT_PUBLIC_KEY_BASE64=GENERAR_CON_SETUP_DEV
JWT_ISSUER=resort-clientes
JWT_AUDIENCE=resort-api
JWT_TTL_SECONDS=900
