# Ejecutar pnpm setup:dev; este archivo documenta nombres, no contiene secretos.
# Demo con cobro al finalizar y proveedores simulados; no usar en produccion.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
HABITACIONES_PORT=3002
RESERVAS_PORT=3003
PAGOS_PORT=3004
JWT_PRIVATE_KEY_BASE64=GENERAR_CON_SETUP_DEV_SOLO_CLIENTES
JWT_PUBLIC_KEY_BASE64=GENERAR_CON_SETUP_DEV
JWT_ISSUER=resort-clientes
JWT_AUDIENCE=resort-api
JWT_TTL_SECONDS=900
SERVICE_TOKEN=GENERAR_CON_SETUP_DEV_MINIMO_32_CARACTERES
BLOQUEO_TTL_SECONDS=600
CLIENTES_URL=http://127.0.0.1:3001
HABITACIONES_URL=http://127.0.0.1:3002
RESERVAS_URL=http://127.0.0.1:3003
PAGOS_URL=http://127.0.0.1:3004
ALLOW_SIMULATED_PROVIDERS=true
NOTIFICATION_POLL_MS=1000
DEPENDENCY_TIMEOUT_MS=3000
CLIENTES_OWNER_PASSWORD=GENERAR_CON_SETUP_DEV
CLIENTES_APP_PASSWORD=GENERAR_CON_SETUP_DEV
CLIENTES_MIGRATION_DATABASE_URL=postgresql://clientes_owner:GENERAR_CON_SETUP_DEV@127.0.0.1:5433/clientes
DATABASE_URL=postgresql://clientes_app:GENERAR_CON_SETUP_DEV@127.0.0.1:5433/clientes
HABITACIONES_OWNER_PASSWORD=GENERAR_CON_SETUP_DEV
HABITACIONES_APP_PASSWORD=GENERAR_CON_SETUP_DEV
HABITACIONES_MIGRATION_DATABASE_URL=postgresql://habitaciones_owner:GENERAR_CON_SETUP_DEV@127.0.0.1:5434/habitaciones
HABITACIONES_DATABASE_URL=postgresql://habitaciones_app:GENERAR_CON_SETUP_DEV@127.0.0.1:5434/habitaciones
RESERVAS_OWNER_PASSWORD=GENERAR_CON_SETUP_DEV
RESERVAS_APP_PASSWORD=GENERAR_CON_SETUP_DEV
RESERVAS_MIGRATION_DATABASE_URL=postgresql://reservas_owner:GENERAR_CON_SETUP_DEV@127.0.0.1:5435/reservas
RESERVAS_DATABASE_URL=postgresql://reservas_app:GENERAR_CON_SETUP_DEV@127.0.0.1:5435/reservas
PAGOS_OWNER_PASSWORD=GENERAR_CON_SETUP_DEV
PAGOS_APP_PASSWORD=GENERAR_CON_SETUP_DEV
PAGOS_MIGRATION_DATABASE_URL=postgresql://pagos_owner:GENERAR_CON_SETUP_DEV@127.0.0.1:5436/pagos
PAGOS_DATABASE_URL=postgresql://pagos_app:GENERAR_CON_SETUP_DEV@127.0.0.1:5436/pagos
