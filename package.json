{
  "name": "proyecto-resort-soa",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel Resort Bahia Azul: cuatro servicios SOA integrados para demostracion academica",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "start": "node --env-file=.env scripts/start-service.mjs clientes",
    "dev": "node --env-file=.env scripts/start-service.mjs clientes --watch",
    "db:migrate": "node --env-file=.env scripts/migrate-service.mjs clientes",
    "start:habitaciones": "node --env-file=.env scripts/start-service.mjs habitaciones",
    "dev:habitaciones": "node --env-file=.env scripts/start-service.mjs habitaciones --watch",
    "db:migrate:habitaciones": "node --env-file=.env scripts/migrate-service.mjs habitaciones",
    "start:reservas": "node --env-file=.env scripts/start-service.mjs reservas",
    "dev:reservas": "node --env-file=.env scripts/start-service.mjs reservas --watch",
    "db:migrate:reservas": "node --env-file=.env scripts/migrate-service.mjs reservas",
    "start:pagos": "node --env-file=.env scripts/start-service.mjs pagos-notificaciones",
    "dev:pagos": "node --env-file=.env scripts/start-service.mjs pagos-notificaciones --watch",
    "db:migrate:pagos": "node --env-file=.env scripts/migrate-service.mjs pagos-notificaciones",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test --test-concurrency=1 services/clientes/test/*.test.js services/habitaciones/test/*.test.js services/reservas/test/*.test.js services/pagos-notificaciones/test/*.test.js test/integration/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage services/clientes/test/*.test.js services/habitaciones/test/*.test.js services/reservas/test/*.test.js services/pagos-notificaciones/test/*.test.js test/integration/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:check": "node scripts/check-contracts.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm contracts:check && pnpm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
