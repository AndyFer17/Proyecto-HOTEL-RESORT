  "paths": {
    "/api/v1/clientes": {
      "post": {
        "summary": "Registrar huésped",
        "responses": {
          "201": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "clienteId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nombre": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "telefono": {
                      "type": "string",
                      "nullable": true
                    },
                    "rol": {
                      "type": "string",
                      "enum": ["HUESPED"]
                    },
                    "creadoEn": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "clienteId",
                    "nombre",
                    "email",
                    "telefono",
                    "rol",
                    "creadoEn"
                  ]
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta del perfil creado",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identificador de correlación generado",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
