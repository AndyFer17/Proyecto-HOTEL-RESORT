  "info": {
    "title": "Hotel Resort - Clientes",
    "version": "0.1.0",
    "description": "Servicio implementado. Errores uniformes y UUID. Los endpoints internos previstos requieren identidad de servicio independiente del JWT de huésped."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
