    "/.well-known/jwks.json": {
      "get": {
        "summary": "Obtener clave pública de firma",
        "responses": {
          "200": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kty": {
                            "type": "string",
                            "enum": ["RSA"]
                          },
                          "n": {
                            "type": "string"
                          },
                          "e": {
                            "type": "string"
                          },
                          "kid": {
                            "type": "string"
                          },
                          "alg": {
                            "type": "string",
                            "enum": ["RS256"]
                          },
                          "use": {
                            "type": "string",
                            "enum": ["sig"]
                          }
                        },
                        "required": ["kty", "n", "e", "kid", "alg", "use"]
                      }
                    }
                  },
                  "required": ["keys"]
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlación generado",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "detalle": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["codigo", "mensaje", "detalle", "traceId"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      }
    }
