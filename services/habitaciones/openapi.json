    "/api/v1/interno/bloqueos": {
      "post": {
        "summary": "Crear bloqueo temporal con tarifa calculada por el servidor",
        "security": [
          {
            "Servicio": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reservaId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "habitacionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "desde": {
                    "type": "string",
                    "format": "date"
                  },
                  "hasta": {
                    "type": "string",
                    "format": "date"
                  },
                  "personas": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "reservaId",
                  "habitacionId",
                  "desde",
                  "hasta",
                  "personas"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operación completada; los reintentos repiten la respuesta persistida.",
