{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Resort - Habitaciones",
    "version": "0.1.0",
    "description": "BORRADOR: contrato preliminar. Servicio NO implementado. Errores uniformes y UUID. Los endpoints internos previstos requieren identidad de servicio independiente del JWT de huésped."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Desarrollo local - puerto futuro"
    }
  ],
  "paths": {
    "/api/v1/habitaciones/disponibilidad": {
      "get": {
        "summary": "Consultar habitaciones disponibles",
        "responses": {
          "200": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "habitaciones": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "habitacionId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "numero": {
                            "type": "string"
                          },
                          "tipo": {
                            "type": "string"
                          },
                          "capacidad": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "tarifaNoche": {
                            "type": "string",
                            "pattern": "^\\d{1,10}\\.\\d{2}$",
                            "example": "660.00"
                          },
                          "moneda": {
                            "type": "string",
                            "enum": ["PEN"]
                          }
                        },
                        "required": [
                          "habitacionId",
                          "numero",
                          "tipo",
                          "capacidad",
                          "tarifaNoche",
                          "moneda"
                        ]
                      }
                    }
                  },
                  "required": ["habitaciones"]
                }
              }
            }
          },
          "400": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "desde",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "personas",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
