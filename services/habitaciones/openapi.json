            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Bloqueo atómico con expiración definida por servidor. Clave idempotente y control de solapamientos obligatorios.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reservaId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "habitacionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "desde": {
                    "type": "string",
                    "format": "date"
                  },
                  "hasta": {
                    "type": "string",
                    "format": "date"
                  },
                  "personas": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "reservaId",
                  "habitacionId",
                  "desde",
                  "hasta",
                  "personas"
                ]
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
