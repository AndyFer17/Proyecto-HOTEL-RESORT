    "/api/v1/interno/bloqueos": {
      "post": {
        "summary": "Reservas solicita bloqueo temporal",
        "responses": {
          "201": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "bloqueoId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "habitacionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "desde": {
                      "type": "string",
                      "format": "date"
                    },
                    "hasta": {
                      "type": "string",
                      "format": "date"
                    },
                    "venceEn": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "total": {
                      "type": "string",
                      "pattern": "^\\d{1,10}\\.\\d{2}$",
                      "example": "660.00"
                    },
                    "moneda": {
                      "type": "string",
                      "enum": ["PEN"]
                    }
                  },
                  "required": [
                    "bloqueoId",
                    "habitacionId",
                    "desde",
                    "hasta",
                    "venceEn",
                    "total",
                    "moneda"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error controlado",
