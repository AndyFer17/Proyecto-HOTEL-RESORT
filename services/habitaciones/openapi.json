{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Resort Bahía Azul Habitaciones",
    "version": "1.0.0",
    "description": "Inventario funcional con bloqueos transaccionales, exclusión de solapamientos, estado operativo e idempotencia persistente. Intervalos [desde,hasta), zona America/Lima y máximo 30 noches. Las rutas internas usan identidad de servicio, no JWT de huésped."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Desarrollo local; usar TLS al exponer fuera del equipo."
    }
  ],
  "paths": {
