    "/api/v1/pagos": {
      "post": {
        "summary": "Pagar saldo de una reserva propia",
        "responses": {
          "201": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pagoId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "estado": {
                      "type": "string",
                      "enum": ["APROBADO", "RECHAZADO", "PENDIENTE"]
                    },
                    "monto": {
                      "type": "string",
                      "pattern": "^\\d{1,10}\\.\\d{2}$",
                      "example": "660.00"
                    }
                  },
                  "required": ["pagoId", "estado", "monto"]
                }
              }
            }
          },
          "400": {
            "description": "Error controlado",
