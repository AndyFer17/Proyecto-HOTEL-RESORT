  "paths": {
    "/api/v1/cuentas/{reservaId}": {
      "get": {
        "summary": "Consultar cuenta de reserva propia",
        "responses": {
          "200": {
            "description": "Resultado correcto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reservaId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "cargos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "cargoId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "reservaId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "origen": {
                            "type": "string"
                          },
                          "origenId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "concepto": {
                            "type": "string"
                          },
                          "monto": {
                            "type": "string",
                            "pattern": "^\\d{1,10}\\.\\d{2}$",
                            "example": "660.00"
                          },
                          "estado": {
                            "type": "string",
                            "enum": ["ACTIVO", "ANULADO"]
                          }
                        },
                        "required": [
                          "cargoId",
                          "reservaId",
                          "origen",
                          "origenId",
                          "concepto",
                          "monto",
                          "estado"
                        ]
                      }
                    },
                    "total": {
                      "type": "string",
                      "pattern": "^\\d{1,10}\\.\\d{2}$",
                      "example": "660.00"
                    },
                    "pagado": {
                      "type": "string",
                      "pattern": "^\\d{1,10}\\.\\d{2}$",
                      "example": "660.00"
                    },
                    "saldo": {
                      "type": "string",
                      "pattern": "^\\d{1,10}\\.\\d{2}$",
                      "example": "660.00"
                    },
                    "moneda": {
                      "type": "string",
                      "enum": ["PEN"]
                    }
                  },
                  "required": [
                    "reservaId",
                    "cargos",
                    "total",
                    "pagado",
                    "saldo",
                    "moneda"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error controlado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reservaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
