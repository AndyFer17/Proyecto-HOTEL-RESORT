        "description": "Validar reserva y monto positivo. Unicidad (origen, origenId). No aceptar cargos arbitrarios de huéspedes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reservaId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "origen": {
                    "type": "string",
                    "enum": ["ALOJAMIENTO", "RESTAURANTE", "SPA_ACTIVIDADES"]
                  },
                  "origenId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "concepto": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "monto": {
                    "type": "string",
                    "pattern": "^\\d{1,10}\\.\\d{2}$",
                    "example": "660.00"
                  }
                },
                "required": [
                  "reservaId",
                  "origen",
                  "origenId",
                  "concepto",
                  "monto"
                ]
              }
            }
          }
        },
