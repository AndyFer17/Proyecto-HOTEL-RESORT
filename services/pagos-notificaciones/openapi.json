            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Solo sandbox; verificar propiedad y saldo. No recibir ni almacenar números de tarjeta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reservaId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "monto": {
                    "type": "string",
                    "pattern": "^\\d{1,10}\\.\\d{2}$",
                    "example": "660.00"
                  },
                  "metodo": {
                    "type": "string",
                    "enum": ["TARJETA_PRUEBA"]
                  },
                  "tokenPago": {
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": ["reservaId", "monto", "metodo", "tokenPago"]
              }
            }
          }
        },
        "security": [
