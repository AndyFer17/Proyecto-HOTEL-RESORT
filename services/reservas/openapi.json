{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Resort - Reservas",
    "version": "0.2.0",
    "description": "Servicio implementado con saga durable y recuperacion por worker. Politica academica: registrar cargo al confirmar y cobrar al final; crear una reserva nunca ejecuta un pago. Los importes proceden de Habitaciones. APIs propias requieren JWT HUESPED RS256; APIs internas identidad de servicio."
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Desarrollo local"
    }
  ],
  "paths": {
    "/api/v1/reservas": {
      "post": {
        "summary": "Crear reserva propia",
        "description": "El huesped se obtiene del sub verificado del JWT. Se rechaza huespedId en el cuerpo. Bloqueo, confirmacion y cargo usan claves por paso y estado local persistido. Un rechazo definitivo compensa inventario antes de finalizar con error.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Clave durable por huesped y operacion registrada. Otra solicitud con esa clave y cuerpo o recurso distinto devuelve HTTP 409. Los rechazos anteriores al registro no vinculan la clave. Repetir permite recuperar el resultado persistido."
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearReserva"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inventario confirmado y cargo registrado. No se ha efectuado ningun cobro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reserva"
                }
              }
            }
          },
          "202": {
            "description": "Operacion persistida en recuperacion. Consultar la reserva o repetir con la misma clave. No implica reserva confirmada ni cancelacion terminada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pendiente"
                }
              }
            }
          },
          "400": {
            "description": "Error controlado con codigo y traceId.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
