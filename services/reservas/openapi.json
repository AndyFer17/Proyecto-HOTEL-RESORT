  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token compartido de servicio de al menos 32 caracteres, separado del JWT de huesped."
      }
    },
    "schemas": {
      "CrearReserva": {
        "type": "object",
        "additionalProperties": false,
        "required": ["habitacionId", "desde", "hasta", "personas"],
        "properties": {
          "habitacionId": {
            "type": "string",
            "format": "uuid"
          },
          "desde": {
            "type": "string",
            "format": "date"
          },
          "hasta": {
            "type": "string",
            "format": "date"
          },
          "personas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "description": "Fechas reales; entrada no pasada segun America/Lima; salida posterior; maximo 30 noches. Tarifas y huesped no se aceptan desde el cliente."
      },
      "ModificarReserva": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "desde": {
            "type": "string",
            "format": "date"
          },
          "hasta": {
            "type": "string",
            "format": "date"
          },
          "personas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "description": "Campos omitidos conservan el valor anterior; no permite cambiar huesped ni habitacion."
      },
      "Reserva": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservaId",
          "huespedId",
          "habitacionId",
          "desde",
          "hasta",
          "personas",
          "estado",
          "total",
          "moneda",
          "bloqueoId",
          "cargoId",
          "version"
        ],
        "properties": {
          "reservaId": {
            "type": "string",
            "format": "uuid"
          },
          "huespedId": {
            "type": "string",
            "format": "uuid"
          },
          "habitacionId": {
            "type": "string",
            "format": "uuid"
          },
          "desde": {
            "type": "string",
            "format": "date"
          },
          "hasta": {
            "type": "string",
            "format": "date"
          },
          "personas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "estado": {
            "type": "string",
            "enum": [
              "PENDIENTE",
              "CONFIRMADA",
              "MODIFICANDO",
              "CANCELANDO",
              "CANCELADA",
              "FALLIDA"
            ]
          },
          "total": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}\\.\\d{2}$",
            "example": "1320.00"
          },
          "moneda": {
            "type": "string",
            "enum": ["PEN"]
          },
          "bloqueoId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
