  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "detalle": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["codigo", "mensaje", "detalle", "traceId"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de identidad de servicio, emisión y scopes pendientes de acordar."
      }
    }
  }
